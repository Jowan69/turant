{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Turant grievance channels",
  "type": "object",
  "required": ["version", "banks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "banks": {
      "type": "array",
      "items": { "$ref": "#/definitions/channel" }
    }
  },
  "definitions": {
    "channel": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "description": "Where this entry was verified from, e.g. evidence/ entry id."
        },
        "emails": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
        },
        "phones": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "portal": {
          "type": "string",
          "pattern": "^https://"
        },
        "address": { "type": "string", "minLength": 1 },
        "nodalOfficer": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
            "phone": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}